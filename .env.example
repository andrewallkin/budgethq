# Copy to `.env` and fill in real values. This file is safe to commit.

# -----------------------------------------------------------------------------
# Database (required)
# The backend builds DATABASE_URL from these vars only; DATABASE_URL is not read.
# With docker-compose.dev.yml, use host name `postgres`.
# On the VPS the control panel manages .env itself and overrides the POSTGRES_*
# values (e.g. POSTGRES_HOST=postgres-central) — the values here are for local dev.
# -----------------------------------------------------------------------------
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=budget_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# -----------------------------------------------------------------------------
# Compose published ports (optional; defaults 8000 / 3000)
# On the VPS the control panel allocates BACKEND_PORT/FRONTEND_PORT in the
# 10000-19999 range and overrides these.
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Compose image tags (optional; the control panel overrides these on the VPS)
# docker-compose.yml resolves image: andrewallkin/budgethq:${DOCKER_IMAGE_BACKEND}.
# Defaults in compose are backend-main-latest / frontend-main-latest; set them here
# (or rely on the defaults) to test prod images locally with `make prod-up`.
# -----------------------------------------------------------------------------
DOCKER_IMAGE_BACKEND=backend-main-latest
DOCKER_IMAGE_FRONTEND=frontend-main-latest

# -----------------------------------------------------------------------------
# Auth (required for register/login)
# RESTRICT_AUTHORIZED_USERS: when true (default), only emails in AUTHORIZED_USERS
# can register, login, and change username. Set to false to allow open auth.
# Use lowercase true or false (case-insensitive). Invalid values default to true.
# AUTHORIZED_USERS: comma-separated list of allowed usernames (emails).
# -----------------------------------------------------------------------------
RESTRICT_AUTHORIZED_USERS=true
AUTHORIZED_USERS=you@example.com

# -----------------------------------------------------------------------------
# Encryption (required to store OpenAI or Investec API keys on a user)
# Fernet key, url-safe base64. Generate, for example:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Cloud / Sheets (optional — ETF price sync skips if unset)
# GCP_SERVICE_ACCOUNT_CREDENTIALS: base64-encoded JSON key (not a file path).
#
# Portfolio FX aggregates use the same spreadsheet as ETF tabs (`GOOGLE_SPREADSHEET_ID`).
# If the FX worksheet is missing (default tab name from GOOGLE_FX_RANGE: BudgetHQ_FX), the
# backend creates it and seeds GOOGLEFINANCE rows for USD/EUR/GBP/ZAR minus the base currency.
# Reads use column A = currency code, B = base units per 1 unit of A (from row 2 upward).
# Share this spreadsheet with the Sheets service account.
#
# GOOGLE_FX_RANGE — A1 notation, default BudgetHQ_FX!A2:B
# INVESTMENTS_FX_BASE_CURRENCY — default ZAR
# INVESTMENTS_FX_CACHE_SECONDS — TTL (seconds) for cached FX reads, default 900
# -----------------------------------------------------------------------------
GCP_SERVICE_ACCOUNT_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
GOOGLE_FX_RANGE=
INVESTMENTS_FX_BASE_CURRENCY=ZAR
INVESTMENTS_FX_CACHE_SECONDS=900

# -----------------------------------------------------------------------------
# Google Cloud Storage (optional — payslip PDF uploads)
# -----------------------------------------------------------------------------
GCS_PAYSLIPS_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Logging (optional)
# LOG_FORMAT=json for JSON logs; REQUEST_LOGGING=true|1|yes enables request logging.
# -----------------------------------------------------------------------------
LOG_DIR=
LOG_FORMAT=
REQUEST_LOGGING=
